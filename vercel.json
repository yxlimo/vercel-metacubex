{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "buildCommand": "node scripts/build.mjs",
    "outputDirectory": "public",
    "regions": [
        "hkg1"
    ],
    "rewrites": [
        {
            "source": "/config.js",
            "destination": "/api/config.js"
        }
    ],
    "headers": [
        {
            "source": "/config.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        },
        {
            "source": "/panel.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ]
}
